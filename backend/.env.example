# SQLite in development. Prisma applies the schema with `npm run prisma:push`.
DATABASE_URL="file:./dev.db"

PORT=3001
# Origin of the Next.js app, for CORS.
CORS_ORIGIN=http://localhost:3000

# Comma-separated emails that are granted the admin role on sign-in.
ADMIN_EMAILS=you@example.com

# Shared secret between the Next.js server and this API for the OAuth routes
# (/auth/google, /auth/discord). Must match INTERNAL_API_KEY in the frontend's
# .env.local. Sign-in is disabled while it is unset.
INTERNAL_API_KEY=change-me-to-a-long-random-string
